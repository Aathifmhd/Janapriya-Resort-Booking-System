# Supabase Postgres connection string: Supabase dashboard > Connect > Transaction pooler (port 6543).
# Replace [YOUR-PASSWORD], percent-encoding any special characters in it (& # ? space ...).
# Any other Postgres connection string works too.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-[INDEX]-[REGION].pooler.supabase.com:6543/postgres
# Optional: Supabase's CA certificate (Database settings > SSL configuration) to also verify the
# server's certificate. Paste the PEM on one line with \n for each line break. Empty = encrypted, unverified.
DATABASE_CA_CERT=
# Long random string used to sign staff login tokens (required; the server won't start without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
