# Neon Postgres connection string (get it from console.neon.tech or ask Claude)
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require
# Long random string used to sign staff login tokens (required; the server won't start without it).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
